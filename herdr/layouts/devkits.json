{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 8],
  "theme": { "light": "devkits-light", "dark": "devkits" },
  "ui_font": "Geist",
  "font": "Geist Mono",
  "preview": "mods/devkits/assets/preview.svg",
  "background": "canvas",
  "terminal_padding": [12, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar", "type": "column", "size": { "px": 280 }, "min": 250, "max": 440, "hidden": false,
      "background": "chrome", "resizable": true,
      "children": [
        { "id": "brand", "type": "block", "size": { "px": 32 }, "window_drag": true,
          "content": { "mod": "devkits", "props": { "view": "brand" } } },
        { "id": "agents", "type": "block", "content": { "mod": "devkits" } }
      ]
    },
    {
      "id": "work", "type": "column", "resizable": false,
      "children": [
        { "id": "header", "type": "block", "size": { "px": 32 }, "window_drag": true,
          "content": { "mod": "devkits", "props": { "view": "header" } } },
        { "id": "workspace-row", "type": "row", "divider": { "width": 1, "color": "border" }, "children": [
        { "id": "workspace-view", "type": "stack", "active": "main", "hidden": true, "size": { "weight": 1 }, "min": 320, "children": [
        { "id": "project-empty", "type": "block", "content": { "mod": "devkits", "props": { "view": "project-empty" } } },
        { "id": "main", "type": "block",
          "content": { "tab": "active", "pane": {
            "gap": 0, "radius": 0, "background": "background", "lone": true,
            "header": { "content": { "mod": "devkits", "props": { "view": "pane" } }, "height": 32, "position": "top", "reveal": "always" }
          } } }
        ] },
        { "id": "editor", "type": "stack", "active": "workspace-editor", "hidden": false, "size": { "weight": 1.6 }, "min": 420, "children": [
          { "id": "workspace-editor", "type": "block", "content": { "mod": "devkits", "props": { "view": "editor" } } },
          { "id": "tasks", "type": "block", "content": { "mod": "devkits-tasks" } }
        ] },
        { "id": "simulator", "type": "block", "hidden": true, "size": { "px": 380 }, "min": 300, "max": 900,
          "content": { "mod": "devkits-simulator", "props": { "view": "simulator" } } }
        ] },
        { "id": "status", "type": "column", "size": { "px": 32 }, "resizable": false, "children": [
          { "id": "status-services", "type": "row", "background": "border", "size": { "px": 1 }, "resizable": false, "children": [
            { "id": "agents-service", "type": "block", "content": { "mod": "devkits-agents", "props": { "view": "service" } } },
            { "id": "system-service", "type": "block", "content": { "mod": "devkits-system", "props": { "view": "service" } } },
            { "id": "tasks-service", "type": "block", "content": { "mod": "devkits-tasks", "props": { "view": "service" } } },
            { "id": "usage-service", "type": "block", "content": { "mod": "devkits-usage", "props": { "view": "service" } } }
          ] },
          { "id": "status-content", "type": "block", "content": { "mod": "devkits", "props": { "view": "status" } } }
        ] }
      ]
    }
  ]
}
